---
import Site from '../layouts/Site.astro';
import { counts } from '../lib/devices';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const at = (path: string) => `${base}/${path}`;
const doors = [
	{
		href: at('instruments/'),
		title: `${counts.instruments} instruments`,
		text: 'Analogue and digital synths, electric pianos, an organ, drum machines and samplers, each with a face of its own.',
		go: 'See the instruments',
	},
	{
		href: at('effects/'),
		title: `${counts.effects} effects`,
		text: 'Compressors, equalisers, channel strips, tape, chorus and reverbs, modelled on the circuits behind them.',
		go: 'See the effects',
	},
	{
		href: at('ai/'),
		title: 'AI on your own computer',
		text: 'A song from a sentence, a melody in Composer, drum parts, the stems of a mix, the notes of a recording. Nothing leaves your computer.',
		go: 'What it can do',
	},
	{
		href: at('agents/'),
		title: 'Make music with an agent',
		text: 'An AI agent can build a song with you, play it, mix it, and show you where things are in the editor.',
		go: 'How it works',
	},
	{
		href: at('write/'),
		title: 'Four ways to write',
		text: `Piano roll, drum sequencer, tracker and patterns as code, all in one song, with ${counts.midi} MIDI devices for arpeggios, chords and beats.`,
		go: 'Writing music',
	},
	{
		href: at('guitar/'),
		title: 'Guitar',
		text: 'Amps, pedals and cabinets modelled on their circuits, and thousands of tones players have captured.',
		go: 'Amps and pedals',
	},
	{
		href: at('mastering/'),
		title: 'Mastering',
		text: 'A mastering suite on the master, and an analyzer that reads loudness the way streaming services do.',
		go: 'The suite',
	},
	{
		href: at('manual/'),
		title: 'The manual',
		text: 'How to use Solmara, from your first clip to automation. New, and growing.',
		go: 'Open the manual',
	},
];
---

<Site
	title="Solmara: a music studio for your computer"
	description="Solmara is a music studio for your computer, in the making: instruments, effects and a timeline to write, play, record and mix, on Mac, Windows and Linux."
	home
>
	<div class="hero-body" slot="hero">
		<img class="logo" src={at('images/solmara-logo.webp')} width="1200" height="599" alt="Solmara" />
		<h1>A music studio for your computer.</h1>
		<p class="lede">Instruments, effects and a timeline to write, play, record and mix. On Mac, Windows and Linux.</p>
		<p class="status">Early in development · nothing to download yet</p>
		<div class="actions">
			<a class="button primary" href="https://github.com/mattias800/solmara">Follow the progress</a>
			<a class="button" href={at('instruments/')}>See the instruments</a>
		</div>
	</div>

	<figure class="editor-shot">
		<a href={at('images/editor.webp')}>
			<img
				src={at('images/editor.webp')}
				srcset={`${at('images/editor-800.webp')} 800w, ${at('images/editor.webp')} 1600w`}
				sizes="(max-width: 1032px) calc(100vw - 32px), 1000px"
				width="1600"
				height="868"
				alt="The Solmara editor: a song's tracks in the arrangement, with the library of instruments beside it"
			/>
		</a>
		<figcaption>The editor as it is today. It will change as Solmara grows.</figcaption>
	</figure>

	<section>
		<h2>Find your way</h2>
		<p class="intro">Everything a song needs comes with Solmara, and your own plugins play beside it.</p>
		<div class="doors">
			{doors.map((door) => (
				<a class="door" href={door.href}>
					<h3>{door.title}</h3>
					<p>{door.text}</p>
					<span class="go">{door.go} →</span>
				</a>
			))}
		</div>
	</section>

	<section class="facts">
		<div>
			<h3>Mac, Windows and Linux</h3>
			<p>The same studio on all three. Start a song on one and finish it on another.</p>
		</div>
		<div>
			<h3>Projects you can trust</h3>
			<p>Saved as readable text, so a version history shows what changed, and brought back after a crash.</p>
		</div>
		<div>
			<h3>Scriptable, if you want it</h3>
			<p>Everything the editor does also works from the command line, so scripts and AI agents can build and mix a song. Leave it alone and Solmara is simply a studio.</p>
		</div>
	</section>

	<section class="help">
		<h2>Found a problem, or have an idea?</h2>
		<p>Tell us on <a href="https://github.com/mattias800/solmara/issues/new/choose">GitHub</a>: what you did, what you heard, and what you expected.</p>
	</section>
</Site>
