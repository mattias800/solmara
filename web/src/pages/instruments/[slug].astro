---
// An instrument's own page: its face, what it is, how it sounds, and where
// the manual has every control of it.
import Shot from '../../components/Shot.astro';
import { getEntry } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { familyOf, instruments, originLabel, type Shown } from '../../lib/devices';
import demos from '../../data/demos.json';
import featureData from '../../data/features.json';

export function getStaticPaths() {
	// The Modular has a page of its own, /modular/.
	return instruments
		.filter((device) => device.id !== 'builtin.modular')
		.map((device) => ({ params: { slug: device.slug }, props: { device } }));
}

const { device } = Astro.props as { device: Shown };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const family = familyOf(device);
const siblings = family?.devices ?? [];
const index = siblings.indexOf(device);
const previous = index > 0 ? siblings[index - 1] : null;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null;
const related = siblings.filter((other) => other !== device).slice(0, 5);
const manual = await getEntry('docs', `manual/devices/instruments/${device.slug}`);
const features = (featureData as unknown as Record<string, { heading: string; lede: string; items: { title: string; text: string }[] }>)[device.slug];
const heard = (demos as Record<string, { title: string; file: string }[]>)[device.slug] ?? [];
const facts = [
	originLabel(device.origin),
	family?.label,
	device.controls ? `${device.controls} controls` : null,
	device.window ? 'A window of its own' : null,
	device.sidechain ? 'Sidechain input' : null,
].filter(Boolean);
---

<Site
	title={device.label}
	section="instruments"
	description={device.blurb}
	eyebrow={device.kindLabel}
	heading={device.label}
	lede={device.blurb}
>
	<section>
		<p class="crumbs">
			<a href={`${base}/instruments/`}>Instruments</a>
			{family && <> / {family.label}</>} / {device.label}
			{device.inProgress && <span class="wip">In progress</span>}
		</p>
		<ul class="facts-row" style="margin-top: 14px">
			{facts.map((fact) => <li>{fact}</li>)}
		</ul>
	</section>

	{device.image && (
		<figure class="big-face" style="margin-top: 32px">
			<Shot src={device.image} alt={`${device.label}'s face`} loading="eager" />
		</figure>
	)}

	{features && (
		<section class="spotlight-features">
			<p class="kind">{features.heading}</p>
			<p class="lede-large">{features.lede}</p>
			<div class="features">
				{features.items.map((item) => (
					<div class="feature">
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				))}
			</div>
		</section>
	)}

	<div class="device-body">
		<div>
			<h2>What it is</h2>
			{device.modelledOn && <p class="origin"><span>Modelled on</span> {device.modelledOn}.</p>}
			{device.description ? <p>{device.description}</p> : <p>{device.blurb}</p>}
			{device.inProgress && (
				<p class="callout">{device.label} is still being built: what it does and how it looks may change before it is done.</p>
			)}
			{heard.length > 0 && (
				<div class="listen">
					<h2>Hear it</h2>
					{heard.map((demo) => (
						<figure>
							<figcaption>{demo.title}</figcaption>
							<audio controls preload="none" src={`${base}/${demo.file}`}></audio>
						</figure>
					))}
				</div>
			)}
		</div>
		<aside class="aside">
			{device.opens && (
				<div class="box opens-box">
					<h3>Bring your sounds</h3>
					<p>{device.opens}</p>
				</div>
			)}
			{manual && (
				<div class="box manual">
					<h3>In the manual</h3>
					<p>Every control of the {device.label}, with its range and where it starts.</p>
					<a href={`${base}/manual/devices/instruments/${device.slug}/`}>Open its chapter →</a>
				</div>
			)}
			{related.length > 0 && (
				<div class="box">
					<h3>More {family?.label.toLowerCase()}</h3>
					<ul>
						{related.map((other) => <li><a href={`${base}/instruments/${other.slug}/`}>{other.label}</a></li>)}
					</ul>
				</div>
			)}
		</aside>
	</div>

	<nav class="siblings" aria-label={`More ${family?.label.toLowerCase() ?? 'instruments'}`}>
		{previous ? <a href={`${base}/instruments/${previous.slug}/`}>← {previous.label}</a> : <span></span>}
		{next ? <a href={`${base}/instruments/${next.slug}/`}>{next.label} →</a> : <span></span>}
	</nav>
</Site>
