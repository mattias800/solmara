---
import Site from '../../layouts/Site.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import { byOrigin, familyOf, instrumentFamilies, instruments } from '../../lib/devices';

const families = instrumentFamilies.filter((family) => family.devices.length > 0);
const intros: Record<string, string> = {
	own: 'Instruments of Solmara’s own design: the wavetable synth, the modular, the samplers and the drum tools.',
	analogue: 'Synths, keys and drum machines modeled on analog instruments, circuit by circuit, and held to references by measurement and by ear.',
	digital: 'Synths modeled on digital instruments, from the early FM and phase-distortion keyboards to the virtual-analog synths of the 1990s and 2000s.',
};
const parts = byOrigin(instruments);
---

<Site
	title="Instruments"
	section="instruments"
	description={`Solmara's ${instruments.length} instruments: our own designs, and emulations of analog and digital synths, keys and drum machines.`}
	eyebrow={`${instruments.length} instruments`}
	heading="Instruments with names, and faces of their own"
	lede="Synths, keys, drum machines and samplers: some of our own design, the rest modeled on the analog and digital instruments they come from. Your own plugins play beside them."
>
	<section>
		<div class="chips" role="group" aria-label="Show a family">
			<button class="chip" type="button" data-show="all" aria-pressed="true">All <small>{instruments.length}</small></button>
			{families.map((family) => (
				<button class="chip" type="button" data-show={family.key} aria-pressed="false">
					{family.label} <small>{family.devices.length}</small>
				</button>
			))}
		</div>
		{parts.map((part) => (
			<div class="instrument-part" data-part={part.key}>
				<h2>{part.label}</h2>
				<p class="intro">{intros[part.key]}</p>
				<div class="cards">
					{part.devices.map((device) => <DeviceCard device={device} family={familyOf(device)?.key} />)}
				</div>
			</div>
		))}
	</section>

	<ul class="more">
		<li><strong>Sample libraries.</strong> The Sampler plays libraries in SFZ, DecentSampler and SoundFont formats.</li>
		<li><strong>Sounds to begin with.</strong> Free libraries from their makers, with their terms shown before you take them.</li>
		<li><strong>Your own plugins.</strong> CLAP, VST3 and Audio Unit instruments play beside Solmara's own.</li>
	</ul>
</Site>

<script>
	// The chips show one family's cards, or all of them; a part with none
	// left to show is hidden with its heading.
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-show]');
	const cards = document.querySelectorAll<HTMLElement>('.card[data-family]');
	for (const chip of chips) {
		chip.addEventListener('click', () => {
			for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
			const show = chip.dataset.show;
			for (const card of cards) card.hidden = show !== 'all' && card.dataset.family !== show;
			for (const part of document.querySelectorAll<HTMLElement>('.instrument-part'))
				part.hidden = ![...part.querySelectorAll<HTMLElement>('.card')].some((card) => !card.hidden);
		});
	}
</script>
