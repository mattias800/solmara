---
// A picture of Solmara, taken at 2x (two pixels to a point), shown at its
// size in points: as sharp as a high-DPI screen shows the editor, and never
// enlarged past what it is. Smaller where its column is narrower.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	/** Pixels to a point in the picture. */
	scale?: number;
	class?: string;
	loading?: 'eager' | 'lazy';
}
const { src, alt, scale = 2, class: className, loading = 'lazy' } = Astro.props;
const width = Math.round(src.width / scale);
---

<Image src={src} alt={alt} width={width} densities={[1, 2]} class={className} loading={loading} />
