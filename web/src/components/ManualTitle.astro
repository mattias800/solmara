---
// The manual's title, as Starlight's own, but it leads to the manual's
// first page rather than to the website's, which is the project's root.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitle } = Astro.locals.starlightRoute;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/manual/`;
---

<a href={home} class="site-title sl-flex">
	{config.logo && logos.dark && (
		<img alt="" src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
	)}
	<span translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
	}
</style>
