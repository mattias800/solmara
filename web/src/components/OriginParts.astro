---
// A family's devices as rows, in three parts: our own designs, then the
// emulations of analogue gear, then of digital gear.
import DeviceRow from './DeviceRow.astro';
import { byOrigin, type Shown } from '../lib/devices';

interface Props {
	devices: Shown[];
}
const unsaid = Astro.props.devices.filter((device) => device.origin === 'unsaid');
const parts = byOrigin(Astro.props.devices);
---

{unsaid.length > 0 && (
	<div class="rows">
		{unsaid.map((device) => <DeviceRow device={device} />)}
	</div>
)}

{parts.map((part) => (
	<div class="origin-part" data-origin={part.key}>
		<h3 class="part-title">{part.label} <small>{part.devices.length}</small></h3>
		<div class="rows">
			{part.devices.map((device) => <DeviceRow device={device} />)}
		</div>
	</div>
))}
