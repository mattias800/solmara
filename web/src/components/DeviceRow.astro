---
// A device on its family's page: its face beside what it is, where it
// comes from, and what it is for. Its id is its name, so other pages link
// to its place here.
import { Image } from 'astro:assets';
import { originLabel, type Shown } from '../lib/devices';

interface Props {
	device: Shown;
}
const { device } = Astro.props;
const summary = device.summary ? device.summary.charAt(0).toUpperCase() + device.summary.slice(1) + '.' : null;
// The hand-written line, then what an emulation is modelled on; a design of
// our own says more of itself from the app's summary where it has one.
const more = device.modelledOn ? null : summary && summary !== device.blurb ? summary : null;
---

<article class="row" id={device.slug} data-origin={device.origin}>
	<div class="shot">
		{device.image && <Image src={device.image} widths={[480, 800, 1200]} sizes="(max-width: 760px) 92vw, 560px" alt={`${device.label}'s face`} />}
	</div>
	<div>
		<p class="kind">{device.kindLabel}</p>
		<h3>{device.label}{device.inProgress && <span class="wip">In progress</span>}</h3>
		<p>{device.blurb}</p>
		{more && <p>{more}</p>}
		<p class:list={['origin', device.origin]}>
			<span>{originLabel(device.origin)}</span>{device.modelledOn && <>, modelled on {device.modelledOn}.</>}
		</p>
	</div>
</article>
