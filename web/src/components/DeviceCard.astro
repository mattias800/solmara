---
// A device in a grid: its face, what it is, its name and a line about it,
// linked to where the website shows it.
import Shot from './Shot.astro';
import { pageOf, type Shown } from '../lib/devices';

interface Props {
	device: Shown;
	family?: string;
}
const { device, family } = Astro.props;
---

<a class="card" href={pageOf(device, import.meta.env.BASE_URL)} data-family={family} data-origin={device.origin}>
	<div class="shot">
		{device.image && <Shot src={device.image} alt={`${device.label}'s face`} />}
	</div>
	<p class="kind">{device.kindLabel}</p>
	<h3>{device.label}{device.inProgress && <span class="wip">In progress</span>}</h3>
	<p>{device.blurb}</p>
	{device.modelledOn && <p class="modelled">Modeled on {device.modelledOn}.</p>}
	{device.opens && <p class="opens">{device.opens}</p>}
</a>
