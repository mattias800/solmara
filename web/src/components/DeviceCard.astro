---
// A device in a grid: its face, what it is, its name and a line about it,
// linked to where the website shows it.
import { Image } from 'astro:assets';
import { pageOf, type Shown } from '../lib/devices';

interface Props {
	device: Shown;
	family?: string;
}
const { device, family } = Astro.props;
---

<a class="card" href={pageOf(device, import.meta.env.BASE_URL)} data-family={family}>
	<div class="shot">
		{device.image && <Image src={device.image} widths={[400, 640]} sizes="(max-width: 640px) 92vw, 320px" alt={`${device.label}'s face`} />}
	</div>
	<p class="kind">{device.kindLabel}</p>
	<h3>{device.label}{device.inProgress && <span class="wip">In progress</span>}</h3>
	<p>{device.blurb}</p>
</a>
